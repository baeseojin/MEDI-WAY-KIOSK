<Window x:Class="MediWay.Display.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MEDI-WAY · 대기 현황판" Width="1280" Height="720" MinWidth="960" MinHeight="600"
 WindowStartupLocation="CenterScreen" Background="#102D3A" FontFamily="맑은 고딕">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22">
   <StackPanel DockPanel.Dock="Left"><TextBlock Text="MEDI-WAY" FontSize="30" FontWeight="Bold" Foreground="#6DE3D9"/><TextBlock Foreground="White" Text="{Binding PageText}" FontSize="17" Margin="0,4,0,0"/></StackPanel>
   <StackPanel HorizontalAlignment="Right"><TextBlock Foreground="White" Text="{Binding ConnectionText}" FontSize="17"/><TextBlock Text="{Binding UpdatedText}" FontSize="14" Margin="0,6,0,0" Foreground="#C5D7DF"/></StackPanel>
  </DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl ItemsSource="{Binding VisibleRooms}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Background="#1C4352" CornerRadius="16" Padding="24" Margin="0,0,16,16" MinHeight="400">
       <StackPanel>
        <TextBlock Foreground="White" Text="{Binding RoomName}" FontSize="29" FontWeight="Bold"/>
        <TextBlock Text="현재 번호" FontSize="17" Margin="0,18,0,0" Foreground="#C5D7DF"/>
        <TextBlock Text="{Binding Number}" FontSize="86" FontWeight="Bold" Foreground="#6DE3D9">
         <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
           <Style.Triggers>
            <DataTrigger Binding="{Binding Emphasize}" Value="True">
             <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.35" AutoReverse="True" RepeatBehavior="4x" FillBehavior="Stop"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
        <TextBlock Foreground="White" Text="{Binding Status}" FontSize="25" FontWeight="Bold" Margin="0,0,0,22"/>
        <DockPanel Margin="0,0,0,12"><TextBlock Foreground="White" Text="대기 번호" FontSize="19" DockPanel.Dock="Left"/><TextBlock Text="{Binding WaitingCount, StringFormat=총 {0}명}" FontSize="17" HorizontalAlignment="Right" Foreground="#C5D7DF"/></DockPanel>
        <ItemsControl ItemsSource="{Binding Waiting}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate><Border Background="#315A68" CornerRadius="6" Margin="0,0,10,10" Padding="15,8"><TextBlock Foreground="White" Text="{Binding QueueNumber, StringFormat={}{0:D3}}" FontSize="25"/></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,8,0,0">
   <StackPanel><TextBlock Foreground="White" Text="호출번호와 진료실을 확인해 주세요." FontSize="19"/><TextBlock Text="{Binding SpeechStatus}" FontSize="14" Foreground="#C5D7DF" Margin="0,4,0,0"/><TextBlock Text="{Binding Message}" FontSize="16" Foreground="#FFD5A6" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  </DockPanel>
 </Grid>
</Window>
