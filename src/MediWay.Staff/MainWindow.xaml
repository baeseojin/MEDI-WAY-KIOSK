<Window x:Class="MediWay.Staff.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MEDI-WAY · 의료진" Height="760" Width="1160" MinHeight="660" MinWidth="960"
 WindowStartupLocation="CenterScreen" Background="#F3F7FA" FontFamily="맑은 고딕" Loaded="OnLoaded">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#163947"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="46"/><Setter Property="Padding" Value="16,8"/><Setter Property="FontSize" Value="17"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#163947"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#087F8C"/><Setter Property="Foreground" Value="White"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel DockPanel.Dock="Left"><TextBlock Text="MEDI-WAY" Foreground="#087F8C" FontSize="28" FontWeight="Bold"/><TextBlock Text="의료진 진료 관리 · 가상 환자 시연" FontSize="15"/></StackPanel>
   <StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding ConnectionText}" FontSize="15"/><TextBlock Text="{Binding LastUpdated}" FontSize="13" Margin="0,6,0,0"/></StackPanel>
  </DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,20">
   <Button DockPanel.Dock="Right" Content="새로고침" Command="{Binding RefreshCommand}"/>
   <TextBlock DockPanel.Dock="Left" Text="진료실" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0"/>
   <ComboBox x:Name="RoomSelector" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="Name" IsEnabled="{Binding CanNavigate}" FontSize="22" Padding="10" MinHeight="50" AutomationProperties.Name="진료실 선택"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ComboBox.ItemContainerStyle></ComboBox>
  </DockPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="대기 목록" FontSize="23" FontWeight="Bold" Margin="0,0,0,12"/>
    <DataGrid x:Name="WaitingGrid" Grid.Row="1" ItemsSource="{Binding Waiting}" SelectedItem="{Binding SelectedWaiting}" IsEnabled="{Binding CanNavigate}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="50" FontSize="20" HeadersVisibility="Column" AutomationProperties.Name="대기 목록" AllowDrop="True" PreviewMouseLeftButtonDown="OnDragStart" PreviewMouseMove="OnDragMove" DragOver="OnDragOver" Drop="OnDrop">
     <DataGrid.Columns><DataGridTextColumn Header="대기번호" Binding="{Binding QueueNumber, StringFormat={}{0:D3}}" Width="*"/><DataGridTemplateColumn Header="상태" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="대기" VerticalAlignment="Center" Margin="8,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
     <WrapPanel><Button Content="위로" Command="{Binding MoveUpCommand}"/><Button Content="아래로" Command="{Binding MoveDownCommand}"/><Button Content="응급 우선 · 맨 앞으로" Command="{Binding PriorityCommand}"/></WrapPanel>
     <TextBlock Text="행을 다른 행 위에 놓으면 그 환자 앞으로 이동합니다. 번호는 바뀌지 않습니다." FontSize="13" Margin="4,6"/>
     <WrapPanel><Button Content="선택 환자 호출" Style="{StaticResource Primary}" Command="{Binding CallCommand}"/><Button Content="대기 접수 취소" Command="{Binding CancelWaitingCommand}"/></WrapPanel>
    </StackPanel>
   </Grid>
   <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="22">
    <StackPanel>
     <TextBlock Text="현재 호출 / 진료" FontSize="23" FontWeight="Bold"/>
     <TextBlock Text="{Binding CurrentNumber}" FontSize="76" FontWeight="Bold" Foreground="#087F8C" Margin="0,14,0,0"/>
     <TextBlock Text="{Binding CurrentStatus}" FontSize="22"/>
     <TextBlock Text="{Binding CurrentDate}" FontSize="15" Margin="0,8,0,14"/>
     <Button Content="진료 시작" Style="{StaticResource Primary}" Command="{Binding StartCommand}"/>
     <Button Content="진료 완료" Command="{Binding CompleteCommand}"/>
     <Button Content="호출 접수 취소" Command="{Binding CancelCurrentCommand}"/>
    </StackPanel>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,14,0,0">
   <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
   <TextBlock Text="{Binding Message}" FontSize="17" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"/>
   <Button Content="같은 작업 결과 재확인" Command="{Binding RetryCommand}" Visibility="{Binding NeedsRetry, Converter={StaticResource Visible}}"/>
   <StackPanel Orientation="Horizontal" Visibility="{Binding NeedsCancelConfirmation, Converter={StaticResource Visible}}"><Button Content="취소 확정" Command="{Binding ConfirmCancelCommand}"/><Button Content="돌아가기" Command="{Binding DismissCancelCommand}"/></StackPanel>
   <TextBlock Text="5초마다 자동 조회합니다. 호출 전 현재 접수 상태를 확인해 주세요." FontSize="13" Margin="0,8,0,0"/>
  </StackPanel>
 </Grid>
</Window>
